<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/mk_bg" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Mk.Caption" android:text="Для тех, кто делает" android:textColor="@color/mk_accent" />
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <TextView style="@style/Mk.Heading" android:text="Ваше дело. Ваши правила." android:textSize="30sp" />
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <TextView style="@style/Mk.Caption" android:text="Находите заказы, договаривайтесь с клиентами и управляйте работой в одном месте." android:textSize="14sp" />
        <Space android:layout_width="1dp" android:layout_height="32dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Section" android:text="Войти в Мастерскую" />
            <Space android:layout_width="1dp" android:layout_height="24dp" />
            <TextView style="@style/Mk.Caption" android:text="Логин" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <EditText android:id="@+id/et_login" style="@style/Mk.Field" android:hint="Ваш логин" android:inputType="text" android:singleLine="true" android:autofillHints="username" />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView style="@style/Mk.Caption" android:text="Пароль" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/et_password" style="@style/Mk.Field" android:hint="Введите пароль" android:layout_width="0dp" android:layout_weight="1" android:inputType="textPassword" android:singleLine="true" android:autofillHints="password" />
                <ImageButton android:id="@+id/iv_toggle_password" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_eye_off" android:tint="@color/mk_ink_soft" android:contentDescription="Показать пароль" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="20dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_login" style="@style/Mk.Button" android:text="Войти" />
            <Space android:layout_width="1dp" android:layout_height="10dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_demo" style="@style/Mk.Button.Secondary" android:text="Посмотреть демо" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <TextView style="@style/Mk.Caption" android:text="Кабинет мастера · Заказчики пользуются сайтом" android:gravity="center" />
    </LinearLayout>
</ScrollView>
<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/mk_bg" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Mk.Heading" android:text="Настройки" />
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Section" android:id="@+id/tv_full_name" />
            <Space android:layout_width="1dp" android:layout_height="6dp" />
            <TextView style="@style/Mk.Caption" android:id="@+id/tv_role" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Section" android:text="Внешний вид" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <TextView style="@style/Mk.Caption" android:text="Выберите удобную тему приложения." />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_theme" style="@style/Mk.Button.Secondary" android:text="Переключить тему" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Section" android:text="Подключение" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <TextView style="@style/Mk.Caption" android:text="Для эмулятора: http://10.0.2.2:8000/. На телефоне укажите адрес компьютера в вашей Wi-Fi сети и порт 8000." />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <EditText android:id="@+id/et_base_url" style="@style/Mk.Field" android:hint="Адрес сервера" android:inputType="textUri" android:singleLine="true" />
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_save_url" style="@style/Mk.Button.Secondary" android:text="Сохранить адрес" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="24dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_logout" style="@style/Mk.Button.Secondary" android:text="Выйти из аккаунта" />
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="100dp">

            <!-- Address card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Address header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_status_progress"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_location"
                                android:tint="@color/status_progress_fg" />
                        </FrameLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="АДРЕС" android:textSize="11sp" android:textColor="@color/text_hint"
                                android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" />
                            <TextView
                                android:id="@+id/tv_address_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginBottom="16dp" />

                    <!-- Account field -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Лицевой счёт" android:textSize="11sp" android:textColor="@color/text_hint"
                        android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" android:layout_marginBottom="8dp" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="52dp"
                        android:background="@drawable/bg_input" android:layout_marginBottom="16dp">
                        <EditText android:id="@+id/et_account" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:background="@null"
                            android:paddingHorizontal="16dp" android:textSize="14sp"
                            android:textColor="@color/text_primary" android:inputType="number" android:singleLine="true" />
                    </FrameLayout>

                    <!-- Installation date (with calendar picker) -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Дата установки" android:textSize="11sp" android:textColor="@color/text_hint"
                        android:fontFamily="sans-serif-medium" android:letterSpacing="0.06" android:layout_marginBottom="8dp" />
                    <LinearLayout
                        android:id="@+id/ll_date_picker2"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/et_install_date2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="дд.мм.гггг"
                            android:textColorHint="@color/text_hint"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="@color/brand" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Old meter card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:background="@drawable/bg_status_pending" android:layout_marginEnd="12dp">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_gravity="center" android:src="@drawable/ic_info_outline"
                                android:tint="@color/status_pending_fg" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Старый счётчик" android:textSize="16sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginBottom="16dp" />

                    <!-- Fields -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                            android:text="Марка" android:textSize="13sp" android:textColor="@color/text_secondary" />
                        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                            android:background="@drawable/bg_input">
                            <EditText android:id="@+id/et_old_brand" android:layout_width="match_parent"
                                android:layout_height="match_parent" android:background="@null"
                                android:paddingHorizontal="14dp" android:textSize="14sp" android:singleLine="true" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                            android:text="Номер" android:textSize="13sp" android:textColor="@color/text_secondary" />
                        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                            android:background="@drawable/bg_input">
                            <EditText android:id="@+id/et_old_number" android:layout_width="match_parent"
                                android:layout_height="match_parent" android:background="@null"
                                android:paddingHorizontal="14dp" android:textSize="14sp" android:singleLine="true" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                            android:text="Показания" android:textSize="13sp" android:textColor="@color/text_secondary" />
                        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                            android:background="@drawable/bg_input">
                            <EditText android:id="@+id/et_old_readings" android:layout_width="match_parent"
                                android:layout_height="match_parent" android:background="@null"
                                android:paddingHorizontal="14dp" android:textSize="14sp"
                                android:inputType="numberDecimal" android:singleLine="true" />
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- New meter card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
                            android:background="@drawable/bg_status_done" android:layout_marginEnd="12dp">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_gravity="center" android:src="@drawable/ic_info_outline"
                                android:tint="@color/status_done_fg" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Новый счётчик" android:textSize="16sp" android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginBottom="16dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                            android:text="Марка" android:textSize="13sp" android:textColor="@color/text_secondary" />
                        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                            android:background="@drawable/bg_input">
                            <EditText android:id="@+id/et_new_brand" android:layout_width="match_parent"
                                android:layout_height="match_parent" android:background="@null"
                                android:paddingHorizontal="14dp" android:textSize="14sp" android:singleLine="true" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
                            android:text="Показания" android:textSize="13sp" android:textColor="@color/text_secondary" />
                        <FrameLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                            android:background="@drawable/bg_input">
                            <EditText android:id="@+id/et_new_readings" android:layout_width="match_parent"
                                android:layout_height="match_parent" android:background="@null"
                                android:paddingHorizontal="14dp" android:textSize="14sp"
                                android:inputType="numberDecimal" android:singleLine="true" />
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Photos card: shown once the act exists -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_photos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Фотофиксация"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="10dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/ll_photos_list"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/btn_add_photo"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="+ Добавить фото"
                        android:textColor="@color/brand"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Finish task button: shown once the act exists -->
            <TextView
                android:id="@+id/btn_finish_task"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                android:background="@drawable/bg_btn_primary"
                android:text="Завершить наряд"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:elevation="4dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Back button -->
    <LinearLayout
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_back_btn"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Назад"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Save button -->
    <TextView
        android:id="@+id/btn_save"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_btn_primary"
        android:paddingHorizontal="32dp"
        android:text="Сохранить акт"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp" />

</FrameLayout>

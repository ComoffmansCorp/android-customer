<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/mk_bg" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/iv_avatar" android:layout_width="76dp" android:layout_height="76dp" android:scaleType="centerCrop" android:src="@drawable/ic_person" android:background="@drawable/bg_mk_icon_circle" app:shapeAppearanceOverlay="@style/Mk.Avatar" app:strokeColor="@color/mk_line" app:strokeWidth="1dp" android:contentDescription="Фото профиля" />
            <LinearLayout android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="16dp">
                <TextView style="@style/Mk.Section" android:id="@+id/tv_full_name" android:text="Мастер" />
                <Space android:layout_width="1dp" android:layout_height="8dp" />
                <TextView style="@style/Mk.Section" android:id="@+id/tv_rating_avg" android:textColor="@color/mk_accent" />
                <TextView style="@style/Mk.Caption" android:id="@+id/tv_rating_count" />
            </LinearLayout>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="24dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Section" android:text="О вас" />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView style="@style/Mk.Caption" android:text="Город" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <EditText android:id="@+id/et_city" style="@style/Mk.Field" android:hint="Где вы работаете" android:inputType="textCapWords" android:singleLine="true" />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <TextView style="@style/Mk.Caption" android:text="Опыт и подход к работе" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <EditText android:id="@+id/et_bio" style="@style/Mk.Field" android:hint="Расскажите, чем можете помочь" android:inputType="textCapSentences|textMultiLine" android:minLines="3" android:gravity="top" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Section" android:text="Ваши специализации" />
            <Space android:layout_width="1dp" android:layout_height="6dp" />
            <TextView style="@style/Mk.Caption" android:text="Выберите услуги, чтобы получать подходящие заказы." />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <EditText android:id="@+id/et_specialization_search" style="@style/Mk.Field" android:hint="Найти услугу" android:singleLine="true" android:inputType="text" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <LinearLayout android:id="@+id/ll_specializations" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/Mk.Button" android:text="Сохранить профиль" />
        <Space android:layout_width="1dp" android:layout_height="28dp" />
        <TextView style="@style/Mk.Section" android:text="Отзывы о вашей работе" />
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout android:id="@+id/ll_reviews" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
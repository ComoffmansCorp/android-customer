<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mk_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- Rating summary card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/mk_accent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_rating_avg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    android:fontFamily="@font/playfair_display"
                    android:textColor="#FFFFFF"
                    tools:text="★ 4.8" />

                <TextView
                    android:id="@+id/tv_rating_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:alpha="0.85"
                    tools:text="12 отзывов" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Reviews list -->
        <LinearLayout
            android:id="@+id/ll_reviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp" />

        <!-- Profile fields card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_city"
                    android:textSize="11sp"
                    android:textColor="@color/mk_ink_hint"
                    android:fontFamily="@font/golos_text"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginBottom="18dp">
                    <EditText
                        android:id="@+id/et_city"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:textColor="@color/mk_ink"
                        android:inputType="text"
                        android:singleLine="true" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_bio"
                    android:textSize="11sp"
                    android:textColor="@color/mk_ink_hint"
                    android:fontFamily="@font/golos_text"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_input">
                    <EditText
                        android:id="@+id/et_bio"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:padding="16dp"
                        android:textSize="14sp"
                        android:textColor="@color/mk_ink"
                        android:inputType="textMultiLine"
                        android:gravity="top" />
                </FrameLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Specializations card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_specializations"
                    android:textSize="11sp"
                    android:textColor="@color/mk_ink_hint"
                    android:fontFamily="@font/golos_text"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/ll_specializations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_mk_btn_primary"
            android:text="@string/btn_save"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/golos_text"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp" />

    </LinearLayout>

</ScrollView>

<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/mk_bg" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Mk.Caption" android:id="@+id/tv_request_meta" android:text="Детали заказа" android:textColor="@color/mk_accent" />
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <TextView style="@style/Mk.Heading" android:id="@+id/tv_service_pill" />
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <TextView style="@style/Mk.Caption" android:id="@+id/tv_status" android:layout_width="wrap_content" android:padding="10dp" android:background="@drawable/bg_mk_status_open" />
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Caption" android:text="Адрес" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <TextView style="@style/Mk.Text" android:id="@+id/tv_address" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Caption" android:text="Заказчик" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <TextView style="@style/Mk.Text" android:id="@+id/tv_client" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Caption" android:text="Что нужно сделать" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <TextView style="@style/Mk.Text" android:id="@+id/tv_description" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout style="@style/Mk.Card">
            <TextView style="@style/Mk.Caption" android:text="Стоимость работы" />
            <Space android:layout_width="1dp" android:layout_height="8dp" />
            <TextView style="@style/Mk.Text" android:id="@+id/tv_price" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_claim_work" style="@style/Mk.Button" android:text="Предложить цену" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_complete_request" style="@style/Mk.Button" android:text="Завершить работу" />
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <LinearLayout style="@style/Mk.Card" android:id="@+id/card_chat" android:visibility="gone">
            <TextView style="@style/Mk.Section" android:text="Переписка с заказчиком" />
            <Space android:layout_width="1dp" android:layout_height="6dp" />
            <TextView style="@style/Mk.Caption" android:text="Детали и договорённости — в одном месте" />
            <Space android:layout_width="1dp" android:layout_height="16dp" />
            <LinearLayout android:id="@+id/ll_chat_messages" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <EditText android:id="@+id/et_chat_message" style="@style/Mk.Field" android:hint="Ваше сообщение" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" />
            <Space android:layout_width="1dp" android:layout_height="10dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_send_message" style="@style/Mk.Button" android:text="Отправить сообщение" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_back" style="@style/Mk.Button.Secondary" android:text="К списку заказов" />
    </LinearLayout>
</ScrollView>
<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Mk.Card" android:layout_marginBottom="14dp">
    <View android:id="@+id/status_strip" android:layout_width="40dp" android:layout_height="4dp" android:background="@drawable/bg_status_strip" android:layout_marginBottom="14dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
            <View android:id="@+id/iv_status_bg" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageView android:id="@+id/iv_status_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView style="@style/Mk.Caption" android:id="@+id/tv_request_meta" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="10dp" />
        <TextView style="@style/Mk.Caption" android:id="@+id/tv_status_badge" android:layout_width="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="6dp" />
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="14dp" />
    <TextView style="@style/Mk.Section" android:id="@+id/tv_request_title" android:textSize="18sp" />
    <Space android:layout_width="1dp" android:layout_height="8dp" />
    <TextView style="@style/Mk.Caption" android:id="@+id/tv_request_subtitle" android:maxLines="3" android:ellipsize="end" />
    <Space android:layout_width="1dp" android:layout_height="16dp" />
    <TextView style="@style/Mk.Section" android:id="@+id/tv_request_price" android:textColor="@color/mk_accent" />
    <Space android:layout_width="1dp" android:layout_height="16dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_claim" style="@style/Mk.Button" android:text="Откликнуться" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_details" style="@style/Mk.Button.Secondary" android:text="Подробнее" android:layout_width="0dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
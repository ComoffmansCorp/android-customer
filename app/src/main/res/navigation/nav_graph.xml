<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.myapplication.LoginFragment"
        android:label="МАСТЕРСКАЯ"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_availableRequests"
            app:destination="@id/availableRequestsFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.myapplication.SettingsFragment"
        android:label="Настройки"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/availableRequestsFragment"
        android:name="com.example.myapplication.AvailableRequestsFragment"
        android:label="Доступные заявки"
        tools:layout="@layout/fragment_available_requests">
        <action
            android:id="@+id/action_availableRequests_to_requestDetail"
            app:destination="@id/requestDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/myRequestsFragment"
        android:name="com.example.myapplication.MyRequestsFragment"
        android:label="Мои заявки"
        tools:layout="@layout/fragment_my_requests">
        <action
            android:id="@+id/action_myRequests_to_requestDetail"
            app:destination="@id/requestDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/requestDetailFragment"
        android:name="com.example.myapplication.RequestDetailFragment"
        android:label="Заявка"
        tools:layout="@layout/fragment_request_detail">
        <argument
            android:name="requestId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

    <fragment
        android:id="@+id/masterProfileFragment"
        android:name="com.example.myapplication.MasterProfileFragment"
        android:label="Профиль мастера"
        tools:layout="@layout/fragment_master_profile" />

</navigation>

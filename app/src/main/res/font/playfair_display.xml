<?xml version="1.0" encoding="utf-8"?>
<!-- Downloadable font (Google Fonts, resolved via Play Services on-device,
     no .ttf vendored, no network calls made by this app itself). Same
     display family as the web's "Мастерская" identity. -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="name=Playfair Display&amp;weight=700"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs">
</font-family>

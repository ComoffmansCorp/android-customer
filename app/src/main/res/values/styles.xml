<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Mk.Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/onest</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mk_ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Mk" />
    <style name="Mk.Heading" parent="Mk.Text">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/unbounded</item>
        <item name="android:textSize">24sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>
    <style name="Mk.Section" parent="Mk.Text">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Mk.Caption" parent="Mk.Text">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mk_ink_hint</item>
    </style>
    <style name="Mk.Field" parent="Mk.Text">
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColorHint">@color/mk_ink_hint</item>
    </style>
    <style name="Mk.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/onest</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mk_on_accent</item>
        <item name="backgroundTint">@color/mk_accent</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Mk.Button.Secondary" parent="Mk.Button">
        <item name="android:textColor">@color/mk_ink</item>
        <item name="backgroundTint">@color/mk_raised</item>
        <item name="strokeColor">@color/mk_line</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Mk.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Mk.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/mk_accent_soft</item>
    </style>
    <style name="Mk.Avatar">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>